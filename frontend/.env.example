# Runna frontend — environment template
# Copy to .env.local and fill in real values. Never commit the filled file.
#
# Only NEXT_PUBLIC_* values belong here — anything in this file is bundled
# into client-side JS and is publicly visible. Secrets go on the backend.

# Base URL of the Express API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Socket.io server URL for realtime task updates
NEXT_PUBLIC_WS_URL=http://localhost:5000

# Paystack PUBLIC key only (pk_test_... / pk_live_...).
# The secret key (sk_...) must never appear in this repo.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
