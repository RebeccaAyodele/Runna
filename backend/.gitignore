logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# testing
/coverage
.nyc_output/

# local uploads / temp files before they reach Cloudinary
/uploads
/tmp
*.tmp

# caches
.eslintcache
.cache/

# os / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.pem
