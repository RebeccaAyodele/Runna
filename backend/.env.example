# Runna backend — environment template
# Copy to .env and fill in real values. Never commit the filled file.

# --- server ---
PORT=5000
NODE_ENV=development
# Exact deployed frontend origin. Never "*" — this API handles payments
# and personal student data.
CORS_ORIGIN=http://localhost:3000

# --- database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12
ALLOWED_SCHOOL_EMAIL_DOMAIN=

# --- payments (Paystack) ---
# Secret key stays server-side only.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- media (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
